{
  "name": "@afriagenesis/intelligence-mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev:stdio": "tsx src/index.ts --transport=stdio",
    "dev:http": "tsx src/index.ts --transport=http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js --transport=http",
    "start:stdio": "node dist/index.js --transport=stdio",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
