{
  "name": "apdp-bj",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start:api": "node dist/apps/api/src/server.js",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "seed:ci": "tsx scripts/seed-ci.ts",
    "smoke:e2e": "tsx scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.8"
  }
}
